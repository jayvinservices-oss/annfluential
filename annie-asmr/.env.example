# Copy this file to .env and fill in the values on your Mac.
# .env is git-ignored. Never paste these keys into a chat.

# --- Video generator (fill only the one you choose in config.yaml) ---
RUNWAY_API_KEY=
REPLICATE_API_TOKEN=

# --- Voice (hosted option) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Voice (VoiceStudio backend on a cloud GPU or another computer) ---
VOICESTUDIO_URL=
VOICESTUDIO_API_KEY=
VOICESTUDIO_PROFILE_ID=

# --- YouTube (OAuth client downloaded from Google Cloud Console) ---
YOUTUBE_CLIENT_SECRETS=.secrets/client_secret.json
YOUTUBE_TOKEN=.secrets/youtube-token.json
